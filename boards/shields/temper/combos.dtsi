/*                KEY POSITIONS (temper 36-key)

  ╭─────────────────────╮ ╭─────────────────────╮
  │ LT4 LT3 LT2 LT1 LT0 │ │ RT0 RT1 RT2 RT3 RT4 │
  │ LM4 LM3 LM2 LM1 LM0 │ │ RM0 RM1 RM2 RM3 RM4 │
  │ LB4 LB3 LB2 LB1 LB0 │ │ RB0 RB1 RB2 RB3 RB4 │
  ╰───────╮ LH2 LH1 LH0 │ │ RH0 RH1 RH2 ╭───────╯
          ╰─────────────╯ ╰─────────────╯         */

#define COMBO_TERM_FAST 18
#define COMBO_TERM_SLOW 30

#define COMBO_IDLE_FAST 150
#define COMBO_IDLE_SLOW 50

/* OS-specific editing combos. */
ZMK_COMBO(mac_cut,   &kp LG(X), LB3 LB1, MAC, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(mac_copy,  &kp LG(C), LB3 LB2, MAC, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(mac_paste, &kp LG(V), LB2 LB1, MAC, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(win_cut,   &kp LC(X), LB3 LB1, WIN, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(win_copy,  &kp LC(C), LB3 LB2, WIN, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(win_paste, &kp LC(V), LB2 LB1, WIN, COMBO_TERM_FAST, COMBO_IDLE_FAST)

ZMK_COMBO(lpar,  &lpar_lt,          RM1 RM2,      MAC WIN NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST, RS(LCTRL), KEYS_L)
ZMK_COMBO(rpar,  &rpar_gt,          RM2 RM3,      MAC WIN NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST, RS(LALT),  KEYS_L)
ZMK_COMBO(lt,    &kp LT,            RM1 RM2,      MAC_NAV WIN_NAV, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(gt,    &kp GT,            RM2 RM3,      MAC_NAV WIN_NAV, COMBO_TERM_FAST, COMBO_IDLE_FAST)

ZMK_COMBO(lbkt,  &kp LBKT,          RB1 RB2,      MAC WIN NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(rbkt,  &kp RBKT,          RB2 RB3,      MAC WIN NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(lbrc,  &kp LBRC,          RB1 RB2,      MAC_NAV WIN_NAV, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(rbrc,  &kp RBRC,          RB2 RB3,      MAC_NAV WIN_NAV, COMBO_TERM_FAST, COMBO_IDLE_FAST)

/* Vertical combos - left hand */
ZMK_COMBO(at,    &kp AT,            LT3 LM3,      MAC WIN MAC_NAV WIN_NAV NUM, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(hash,  &kp HASH,          LT2 LM2,      MAC WIN MAC_NAV WIN_NAV NUM, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(dllr,  &kp DLLR,          LT1 LM1,      MAC WIN MAC_NAV WIN_NAV NUM, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(prcnt, &kp PRCNT,         LT0 LM0,      MAC WIN MAC_NAV WIN_NAV NUM, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)

ZMK_COMBO(grave, &kp GRAVE,         LM3 LB3,      MAC WIN MAC_NAV WIN_NAV NUM, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(bslh,  &kp BSLH,          LM2 LB2,      MAC WIN MAC_NAV WIN_NAV NUM, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(fslh,  &kp FSLH,          LM1 LB1,      MAC WIN MAC_NAV WIN_NAV NUM, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(tilde, &kp TILDE,         LM0 LB0,      MAC WIN MAC_NAV WIN_NAV NUM, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)

/* Vertical combos - right hand */
ZMK_COMBO(caret, &kp CARET,         RT0 RM0,      MAC WIN MAC_NAV WIN_NAV NUM, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(plus,  &kp PLUS,          RT1 RM1,      MAC WIN MAC_NAV WIN_NAV NUM, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(star,  &kp STAR,          RT2 RM2,      MAC WIN MAC_NAV WIN_NAV NUM, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(amps,  &kp AMPS,          RT3 RM3,      MAC WIN MAC_NAV WIN_NAV NUM, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)

ZMK_COMBO(under, &kp UNDER,         RM0 RB0,      MAC WIN MAC_NAV WIN_NAV NUM, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(minus, &kp MINUS,         RM1 RB1,      MAC WIN MAC_NAV WIN_NAV NUM, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(equal, &kp EQUAL,         RM2 RB2,      MAC WIN MAC_NAV WIN_NAV NUM, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(pipe,  &kp PIPE,          RM3 RB3,      MAC WIN MAC_NAV WIN_NAV NUM, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)

/* System power combos (four-key, require both hands to prevent accidental trigger) */
ZMK_COMBO(soft_off_l, &soft_off,   LT4 RT4 LB4 RB4, MAC WIN, 100, COMBO_IDLE_FAST)
ZMK_COMBO(bootldr,    &bootloader, LT0 RT0 LB0 RB0, MAC WIN, 100, COMBO_IDLE_FAST)
